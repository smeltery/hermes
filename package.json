{
  "name": "hermes-workspace",
  "private": true,
  "packageManager": "bun@1.3.13",
  "workspaces": ["website"],
  "scripts": {
    "check": "bash scripts/check.sh",
    "check:docs": "markdownlint-cli2 && bun scripts/check-docs.mjs",
    "check:loc": "bun scripts/check-loc.mjs",
    "test:tooling": "bun test scripts/*.test.mjs",
    "website:build": "bun run --cwd website build",
    "website:dev": "bun run --cwd website dev",
    "og": "bun scripts/render-og.mjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "github-slugger": "2.0.0",
    "jsdom": "30.1.3",
    "markdown-it": "15.0.3",
    "markdownlint-cli2": "0.23.3",
    "mermaid": "12.2.0"
  },
  "trustedDependencies": ["sharp", "unrs-resolver"]
}
